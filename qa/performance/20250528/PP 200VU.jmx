<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Privacy Portal Performance Tests">
      <stringProp name="TestPlan.comments">V0.1</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Global Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="baseUrlSIT" elementType="Argument">
            <stringProp name="Argument.name">baseUrlSIT</stringProp>
            <stringProp name="Argument.value">sit.account.alberta.ca</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">For reference only</stringProp>
          </elementProp>
          <elementProp name="baseUrlPREL" elementType="Argument">
            <stringProp name="Argument.name">baseUrlPREL</stringProp>
            <stringProp name="Argument.value">account.alberta.ca</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">For reference only</stringProp>
          </elementProp>
          <elementProp name="appPathSIT" elementType="Argument">
            <stringProp name="Argument.name">appPathSIT</stringProp>
            <stringProp name="Argument.value">app-syst</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">For reference only</stringProp>
          </elementProp>
          <elementProp name="appPathPREL" elementType="Argument">
            <stringProp name="Argument.name">appPathPREL</stringProp>
            <stringProp name="Argument.value">app-prodrelease</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">For reference only</stringProp>
          </elementProp>
          <elementProp name="baseUrl" elementType="Argument">
            <stringProp name="Argument.name">baseUrl</stringProp>
            <stringProp name="Argument.value">account.alberta.ca</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Used in actual test</stringProp>
          </elementProp>
          <elementProp name="appPath" elementType="Argument">
            <stringProp name="Argument.name">appPath</stringProp>
            <stringProp name="Argument.value">app-prodrelease</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Used in actual test</stringProp>
          </elementProp>
          <elementProp name="headerSaAlbertaSyn" elementType="Argument">
            <stringProp name="Argument.name">headerSaAlbertaSyn</stringProp>
            <stringProp name="Argument.value">${__groovy(System.getenv(&quot;TEST_AUTOMATION_EXTRA_HEADER_VALUE&quot;))}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc"></stringProp>
          </elementProp>
          <elementProp name="isAuthenticated" elementType="Argument">
            <stringProp name="Argument.name">isAuthenticated</stringProp>
            <stringProp name="Argument.value">/privacy/complaints/api/v1/is-authenticated</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="sasToken" elementType="Argument">
            <stringProp name="Argument.name">sasToken</stringProp>
            <stringProp name="Argument.value">/privacy/complaints/api/v1/sas-token</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="complaints" elementType="Argument">
            <stringProp name="Argument.name">complaints</stringProp>
            <stringProp name="Argument.value">/privacy/complaints/api/v1/complaints</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="sendEmail" elementType="Argument">
            <stringProp name="Argument.name">sendEmail</stringProp>
            <stringProp name="Argument.value">/privacy/complaints/api/v1/send-email</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="apiPath" elementType="Argument">
            <stringProp name="Argument.name">apiPath</stringProp>
            <stringProp name="Argument.value">api-prodrelease</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="rampUp" elementType="Argument">
            <stringProp name="Argument.name">rampUp</stringProp>
            <stringProp name="Argument.value">180</stringProp>
            <stringProp name="Argument.desc">Set to 180 for actual tests</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="duration" elementType="Argument">
            <stringProp name="Argument.name">duration</stringProp>
            <stringProp name="Argument.value">300</stringProp>
            <stringProp name="Argument.desc">Set to 300 for actual tests</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="threadsSetA" elementType="Argument">
            <stringProp name="Argument.name">threadsSetA</stringProp>
            <stringProp name="Argument.value">14</stringProp>
            <stringProp name="Argument.desc">Set to 20 for actual tests</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="threadsSetB" elementType="Argument">
            <stringProp name="Argument.name">threadsSetB</stringProp>
            <stringProp name="Argument.value">200</stringProp>
            <stringProp name="Argument.desc">Set to 300 for actual tests</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header manager" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="sec-ch-ua" elementType="Header">
            <stringProp name="Header.name">sec-ch-ua</stringProp>
            <stringProp name="Header.value">&quot;Chromium&quot;;v=&quot;124&quot;, &quot;Google Chrome&quot;;v=&quot;124&quot;, &quot;Not-A.Brand&quot;;v=&quot;99&quot;</stringProp>
          </elementProp>
          <elementProp name="sec-ch-ua-mobile" elementType="Header">
            <stringProp name="Header.name">sec-ch-ua-mobile</stringProp>
            <stringProp name="Header.value">?0</stringProp>
          </elementProp>
          <elementProp name="sec-ch-ua-platform" elementType="Header">
            <stringProp name="Header.name">sec-ch-ua-platform</stringProp>
            <stringProp name="Header.value">&quot;Windows&quot;</stringProp>
          </elementProp>
          <elementProp name="User-Agent" elementType="Header">
            <stringProp name="Header.name">User-Agent</stringProp>
            <stringProp name="Header.value">Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36</stringProp>
          </elementProp>
          <elementProp name="DNT" elementType="Header">
            <stringProp name="Header.name">DNT</stringProp>
            <stringProp name="Header.value">1</stringProp>
          </elementProp>
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">sa-alberta-syn</stringProp>
            <stringProp name="Header.value">${headerSaAlbertaSyn}</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>

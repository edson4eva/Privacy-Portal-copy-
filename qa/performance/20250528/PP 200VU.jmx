        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="User defined variables" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.time.LocalDateTime
import java.time.format.DateTimeFormatter
import java.util.Random

// Helper method to generate random 8-letter alphabetic string
def randomAlphaString(int length) {
    def chars = (&apos;A&apos;..&apos;Z&apos;) + (&apos;a&apos;..&apos;z&apos;)
    new Random().with { r -&gt;
        (1..length).collect { chars[r.nextInt(chars.size())] }.join()
    }
}

// Generate values
def firstName = randomAlphaString(8)
def lastName = randomAlphaString(8)

def now = LocalDateTime.now()
def dateFormatter = DateTimeFormatter.ofPattern(&quot;M/d/yyyy&quot;)        // e.g. 5/12/2025
def timeFormatter = DateTimeFormatter.ofPattern(&quot;h:mm:ss a&quot;)       // e.g. 11:25:07 AM

def dateOfSubmission = now.format(dateFormatter)
def timeOfSubmission = now.format(timeFormatter)

// Set JMeter variables
vars.put(&quot;firstName&quot;, firstName)
vars.put(&quot;lastName&quot;, lastName)
vars.put(&quot;dateOfSubmission&quot;, dateOfSubmission)
vars.put(&quot;timeOfSubmission&quot;, timeOfSubmission)
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
